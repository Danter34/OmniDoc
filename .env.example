# Docker Compose project settings
COMPOSE_PROJECT_NAME=omnidoc
APP_URL=http://localhost
GOTENBERG_BASE_URL=http://gotenberg:3000
# Local backend: Gotenberg__BaseUrl=http://localhost:3000 (run Next.js on another port).

# PostgreSQL
POSTGRES_DB=omnidoc_db
POSTGRES_USER=omnidoc
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# JWT (minimum 32 bytes; generate a unique random value for production)
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=OmniDocApi
JWT_AUDIENCE=OmniDocClient
JWT_EXPIRY_MINUTES=1440

# AI provider: Gemini or Mock
AI_PROVIDER=Gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Mailpit inbox: http://localhost:8025. Use a real SMTP server for deployed email delivery.
# Local backend uses EmailSettings__Host=localhost and EmailSettings__Port=1025.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=OmniDoc
SMTP_ENABLE_SSL=false
# Enable only for demo environments; Development already returns debugOtp.
EMAIL_SHOW_DEMO_OTP=false

# Showcase: opt-in; these credentials are PUBLIC and must match the frontend build.
# Local showcase: set both flags true, then rebuild frontend (NEXT_PUBLIC_* is build-time).
# Fresh database: docker compose up -d db redis
# Apply existing migrations before seed: docker compose run --rm --no-deps backend --migrate-only=true
SHOWCASE_ENABLED=false
SHOWCASE_SEED_ON_STARTUP=false
SHOWCASE_USER_ID=b4987f7e-48cc-4ba5-a117-10ac4cbced01
SHOWCASE_WORKSPACE_ID=b4987f7e-48cc-4ba5-a117-10ac4cbced02
SHOWCASE_EMAIL=recruiter@omnidoc.io
SHOWCASE_PASSWORD=OmniDoc-Showcase2026!
# Immediate trusted Nginx container IP. Refresh after recreating that container.
# Empty = forwarded headers from non-loopback peers are ignored (shared proxy IP budget).
REVERSE_PROXY_IP=
