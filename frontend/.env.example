# Server-side target used by Next.js rewrites in local development.
OMNIDOC_API_URL=http://localhost:5151

# Optional public URL when the API is exposed directly and CORS is configured.
# Keep empty to use the same-origin Next.js proxy.
NEXT_PUBLIC_API_URL=

# Public frontend origin used to resolve canonical metadata and social images.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Showcase UI defaults to enabled when unset. Set false to hide Quick-Fill.
# Public build-time demo credentials, never personal or production credentials.
# The Step 2 seeder must match these values; UI alone does not create an account.
# Enable on a public deployment only after account/corpus policies are installed.
NEXT_PUBLIC_SHOWCASE_ENABLED=true
NEXT_PUBLIC_SHOWCASE_EMAIL=guest@omnidoc.io
NEXT_PUBLIC_SHOWCASE_PASSWORD=OmniDoc-Showcase2026!
# Optional; empty resolves the first owned workspace after authenticated login.
NEXT_PUBLIC_SHOWCASE_WORKSPACE_ID=
